{
  "expo": {
    "name": "PerpAI",
    "slug": "perpai",
    "version": "0.6.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "perpai",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.wpuresearch.perpai",
      "infoPlist": {
        "NSCameraUsageDescription": "PerpAI, Perpa'daki QR kodları okuyup konumunu bulmak için kamerayı kullanır."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1726",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wpuresearch.perpai",
      "versionCode": 6
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1726",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PerpAI, Perpa'daki QR kodları okuyup konumunu bulmak için kamerayı kullanır.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Alışveriş listesinin fotoğrafını seçmek için galerine erişiriz. Fotoğraf telefonda kalır.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class com.google.mlkit.** { *; }\n-keep class com.google.android.gms.internal.mlkit_** { *; }\n-keep class com.google.android.gms.vision.** { *; }\n-keep class expo.modules.gl.** { *; }\n-keep class * extends expo.modules.kotlin.views.ExpoView { <init>(...); }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
