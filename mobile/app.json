{
  "expo": {
    "name": "PerpAI",
    "slug": "perpai",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "perpai",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.wpuresearch.perpai",
      "infoPlist": {
        "NSCameraUsageDescription": "PerpAI, Perpa'daki QR kodları okuyup konumunu bulmak için kamerayı kullanır."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1726",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wpuresearch.perpai",
      "versionCode": 3
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1726",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PerpAI, Perpa'daki QR kodları okuyup konumunu bulmak için kamerayı kullanır.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
